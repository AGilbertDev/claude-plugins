{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Read(**/secrets/**)",
      "Bash(cat *.env*)",
      "Bash(cat *.env)",
      "Bash(grep *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)"
    ]
  }
}
