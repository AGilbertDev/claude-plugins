#!/usr/bin/env bash
# Install the AGilbertDev recipe into the current project.
# Links the local instruction skills from this repo, downloads the third-party
# skills from their upstream sources, merges the shared settings baseline, and
# wires the always-loaded conventions core into the project's CLAUDE.md. Run
# from your project root:
#
#   bash .recipes/bin/install
#
# Re-runnable. Skills land in .claude/skills (gitignore that dir).
set -euo pipefail

RECIPE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROJECT="$(pwd)"
AGENT="claude-code"

if [ "$RECIPE_DIR" = "$PROJECT" ]; then
  echo "Run this from your PROJECT root, not from inside the recipe repo." >&2
  exit 1
fi

mkdir -p "$PROJECT/.claude/agents"
mkdir -p "$PROJECT/.claude/skills"

echo "==> Linking the agilbertdev agent set"
# One symlink for the whole shared set, not one per file. Claude Code scans
# .claude/agents/ recursively, so the subfolder is discovered. New agents in
# the recipe repo show up on the next pointer bump with no install re-run.
#
# This install only ever touches symlinks that point into .recipes. It never
# deletes or overwrites a real file or folder. So a project-specific agent kept
# as a real .md at the top level of .claude/agents/ is left untouched, and if
# you diverge a shared agent by replacing its symlink with a real copy, the
# install skips it instead of clobbering your copy.
#
# Remove only links that point into the shared recipe (old per-file links from
# earlier installs and the agilbertdev link itself), then relink.
find "$PROJECT/.claude/agents" -maxdepth 1 -type l 2>/dev/null | while read -r link; do
  case "$(readlink "$link")" in
    *.recipes/agents/* | *.recipes/plugins/*/agents/*) rm -f "$link" ;;
  esac
done
if [ -e "$PROJECT/.claude/agents/agilbertdev" ] && [ ! -L "$PROJECT/.claude/agents/agilbertdev" ]; then
  echo "    agilbertdev is a real folder here (diverged) — left untouched"
else
  ln -sfn "../../.recipes/plugins/workflow/agents" "$PROJECT/.claude/agents/agilbertdev"
  ln -sfn "../../.recipes/plugins/nuxt-conventions/agents" "$PROJECT/.claude/agents/agilbertdev-nuxt"
  echo "    linked agilbertdev -> .recipes/plugins/workflow/agents"
  echo "    linked agilbertdev-nuxt -> .recipes/plugins/nuxt-conventions/agents"
fi

echo "==> Linking local instruction skills from the recipe"
# Same rule as the agents above: only ever touch symlinks that point into the
# shared recipe. Downloaded third-party skills are real folders, so they are
# left untouched, and if you diverge a my-* skill by replacing its symlink with
# a real copy, the install skips it instead of clobbering your copy.
# Remove only links into .recipes/skills so renamed or retired skills do not
# linger as dead links.
find "$PROJECT/.claude/skills" -maxdepth 1 -type l 2>/dev/null | while read -r link; do
  case "$(readlink "$link")" in
    *.recipes/skills/* | *.recipes/plugins/*/skills/*) rm -f "$link" ;;
  esac
done
for dir in "$RECIPE_DIR"/plugins/*/skills/*/; do
  name="$(basename "$dir")"
  if [ -e "$PROJECT/.claude/skills/$name" ] && [ ! -L "$PROJECT/.claude/skills/$name" ]; then
    echo "    $name is a real folder here (diverged) — left untouched"
  else
    rel="${dir#"$RECIPE_DIR"/}"
    ln -sfn "../../.recipes/${rel%/}" "$PROJECT/.claude/skills/$name"
    echo "    linked $name"
  fi
done

echo "==> Downloading third-party skills from upstream (skills CLI)"
npx -y skills add antfu/skills                        --skill vue vue-best-practices nuxt --agent "$AGENT"
npx -y skills add pproenca/dot-skills                 --skill zod                         --agent "$AGENT"
npx -y skills add midudev/autoskills                  --skill bun                         --agent "$AGENT"
npx -y skills add giuseppe-trisciuoglio/developer-kit --skill tailwind-css-patterns       --agent "$AGENT"
npx -y skills add wshobson/agents                     --skill typescript-advanced-types   --agent "$AGENT"
npx -y skills add addyosmani/web-quality-skills       --skill accessibility seo           --agent "$AGENT"
npx -y skills add hyf0/vue-skills                      --skill vue-debug-guides           --agent "$AGENT"
npx -y skills add anthropics/skills                    --skill frontend-design            --agent "$AGENT"

echo "==> Fetching official Nuxt UI skill (nuxt/ui @ v4, skills/nuxt-ui)"
TMP="$(mktemp -d)"
git clone --no-checkout --depth 1 --filter=blob:none --branch v4 https://github.com/nuxt/ui.git "$TMP/ui" >/dev/null 2>&1
git -C "$TMP/ui" sparse-checkout set --no-cone skills/nuxt-ui >/dev/null
git -C "$TMP/ui" checkout -q
rm -rf "$PROJECT/.claude/skills/nuxt-ui"
cp -r "$TMP/ui/skills/nuxt-ui" "$PROJECT/.claude/skills/nuxt-ui"
rm -rf "$TMP"

echo "==> Merging the shared settings baseline into .claude/settings.json"
# Union the security deny rules and append the hooks without clobbering any
# project-specific permissions or hooks. Idempotent across re-runs.
RECIPE_DIR="$RECIPE_DIR" PROJECT="$PROJECT" node <<'NODE'
const fs = require("fs")
const basePath = process.env.RECIPE_DIR + "/settings.base.json"
const outPath = process.env.PROJECT + "/.claude/settings.json"
const base = JSON.parse(fs.readFileSync(basePath, "utf8"))
let cur = {}
try { cur = JSON.parse(fs.readFileSync(outPath, "utf8")) } catch (e) {}
cur.permissions = cur.permissions || {}
const bp = base.permissions || {}
if (Array.isArray(bp.deny)) {
  cur.permissions.deny = [...new Set([...(cur.permissions.deny || []), ...bp.deny])]
}
if (base.hooks) {
  cur.hooks = cur.hooks || {}
  for (const ev of Object.keys(base.hooks)) {
    const existing = cur.hooks[ev] || []
    const seen = new Set(existing.map((x) => JSON.stringify(x)))
    for (const h of base.hooks[ev]) {
      const k = JSON.stringify(h)
      if (!seen.has(k)) { existing.push(h); seen.add(k) }
    }
    cur.hooks[ev] = existing
  }
}
fs.writeFileSync(outPath, JSON.stringify(cur, null, 2) + "\n")
NODE
echo "    settings.json updated"

echo "==> Wiring the conventions core into CLAUDE.md"
# Claude Code only auto-loads CLAUDE.md, not AGENTS.md. So the project's
# CLAUDE.md imports the shared core (always-loaded conventions) and, when
# present, the project's own AGENTS.md. Idempotent: only adds missing lines.
CLAUDE_MD="$PROJECT/CLAUDE.md"
if [ ! -f "$CLAUDE_MD" ]; then
  cat > "$CLAUDE_MD" <<'MD'
# Project memory

Personal conventions load from the shared recipe. Project-specific facts live in AGENTS.md.

@.recipes/CLAUDE.md
MD
  [ -f "$PROJECT/AGENTS.md" ] && printf '@AGENTS.md\n' >> "$CLAUDE_MD"
  echo "    created CLAUDE.md"
else
  grep -qxF '@.recipes/CLAUDE.md' "$CLAUDE_MD" || printf '\n@.recipes/CLAUDE.md\n' >> "$CLAUDE_MD"
  if [ -f "$PROJECT/AGENTS.md" ]; then
    grep -qxF '@AGENTS.md' "$CLAUDE_MD" || printf '@AGENTS.md\n' >> "$CLAUDE_MD"
  fi
  echo "    CLAUDE.md already wired"
fi

echo "==> Installing the devcontainer sandbox (if absent)"
# A Claude Code sandbox container so an agent can run autonomously in isolation:
# a Node base with git, curl, sudo, bun, and the Claude Code CLI. Copied as real
# files (not symlinked like skills) so each project commits its own copy and can
# diverge. Never clobbers an existing .devcontainer.
if [ -e "$PROJECT/.devcontainer" ]; then
  echo "    .devcontainer already present — left untouched"
else
  mkdir -p "$PROJECT/.devcontainer"
  cp "$RECIPE_DIR/templates/devcontainer/devcontainer.json" "$PROJECT/.devcontainer/devcontainer.json"
  cp "$RECIPE_DIR/templates/devcontainer/Dockerfile" "$PROJECT/.devcontainer/Dockerfile"
  cp "$RECIPE_DIR/templates/devcontainer/setup.sh" "$PROJECT/.devcontainer/setup.sh"
  chmod +x "$PROJECT/.devcontainer/setup.sh"
  echo "    created .devcontainer"
fi

echo "==> Done."
echo
echo "Agents (.claude/agents/agilbertdev):"
ls "$PROJECT/.claude/agents/agilbertdev"
echo
echo "Skills in .claude/skills:"
ls "$PROJECT/.claude/skills"
echo
echo "Commit: CLAUDE.md, .claude/settings.json, .gitmodules, the .recipes pointer, .gitignore, and .devcontainer/."
echo "Ignore (downloaded, re-installable): add '.claude/skills/' and '.claude/agents/' to .gitignore."
